# Salin berkas ini menjadi .env lalu sesuaikan.
# Port aplikasi
PORT=3000
# 0.0.0.0 supaya bisa dibuka dari HP di Wi-Fi yang sama
HOST=0.0.0.0
# Lokasi berkas database SQLite (relatif dari folder proyek)
DB_FILE=data/warung.db
# Zona waktu warung
APP_TZ=Asia/Jakarta
# Akun masuk admin (Bu Mimin). Ganti kata sandi sebelum dipakai sungguhan.
ADMIN_EMAIL=dapoerbumimin@gmail.com
ADMIN_KATA_SANDI=dapoeradmin123
# Kontak tim pengembang (Pusat Bantuan). Boleh dikosongkan.
# WhatsApp pakai format internasional tanpa +, contoh 6281234567890
KONTAK_EMAIL=
KONTAK_WA=
